\"blog_public_off\" name=\"blog_public\" value=\"0\"  />\n\t\t\t\t\t<label class=\"checkbox\" for=\"blog_public_off\">No</label>\n\t\t\t\t</span>\n\t\t\t</p>\n\t\t</fieldset>\n\t</div>\n\n\t\t\t<p class=\"submit\"><input type=\"submit\" name=\"submit\" class=\"submit\" value=\"Create Site\" /></p>\n\t</form>\n\t",
