{
  "name": "speedyspec-guide",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "guide": "bun packages/cli/src/main.ts",
    "runner:link": "bun scripts/link-server.ts",
    "runner:build": "cargo build --release --manifest-path runner/Cargo.toml",
    "runner:test": "cargo test --manifest-path runner/Cargo.toml"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "22",
    "bun-types": "^1.4.5",
    "typescript": "^5.9.0"
  }
}
