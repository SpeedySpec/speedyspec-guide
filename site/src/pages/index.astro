---
import VerdictPill from '../components/VerdictPill.astro';
import Base from '../layouts/Base.astro';
import { loadGuideData } from '../model/data.ts';
import { guidePath, guideTracks } from '../model/guides.ts';
import type { SpeedySpecVerdict } from '../model/verdict.ts';
const d = await loadGuideData();
const tracks = guideTracks(d);
const verdicts: [SpeedySpecVerdict, string][] = [
  ['works-as-wordpress', 'Your code behaves the same; every claim is backed by a recorded scenario or test.'],
  ['works-with-differences', 'It works, but something differs; the page says what and what to do instead.'],
  ['breaks', 'Code relying on this needs changing before it runs on SpeedySpec.'],
  ['new-in-speedyspec', 'Only SpeedySpec has it.'],
  ['not-in-speedyspec', 'Its seam is not ported yet, so SpeedySpec does not provide it.'],
  ['unknown', 'Not compared yet.'],
];
---
<Base title="Home">
  <main class="page">
    <h1>SpeedySpec Guide</h1>
    <p>Learn to write WordPress plugins: how WordPress's functions work together, how SpeedySpec runs them, and every function's reference. Every code example is run and checked on WordPress.</p>
    <section class="home-guides">
      <h2>Guides</h2>
      <p>Start with the learning path, then read the topic guides for the parts of WordPress your plugin uses.</p>
      <ol class="home-path">
        {tracks.path.map((g) => <li><a href={guidePath(g)}>{g.title}</a> <span class="muted">{g.summary}</span></li>)}
      </ol>
      <p><a href="/guides/">All guides</a>: the learning path, topics, and contributing to WordPress and SpeedySpec.</p>
    </section>
    <section class="home-reference">
      <h2>Reference</h2>
      <p>Every function, class and hook, by seam. A seam is a boundary where behaviour can be swapped, so the functions and classes that work together are documented together.</p>
      <ul>
        <li><a href="/wordpress/">WordPress API</a>: WordPress {d.inventory.version || ''} as it is, readable on its own.</li>
        <li><a href="/speedyspec/">SpeedySpec API</a>: verdicts, differences, porting guides, architecture and the new API.</li>
      </ul>
      <h3>Reading a verdict</h3>
      <dl class="legend">
        {verdicts.map(([v, text]) => (<><dt><VerdictPill verdict={v} /></dt><dd>{text}</dd></>))}
      </dl>
      <h3>Start porting</h3>
      <ul class="porting-links">
        {d.seams.map((s) => <li><a href={`/speedyspec/porting/${s.id}/`}>{s.name}</a></li>)}
      </ul>
    </section>
  </main>
</Base>
