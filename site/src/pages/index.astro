---
import HomeCards from '../components/HomeCards.astro';
import Page from '../layouts/Page.astro';
import { loadGuideData } from '../model/data.ts';
import { guidePath, guideTracks } from '../model/guides.ts';

const d = await loadGuideData();
const tracks = guideTracks(d);
const first = tracks.path[0];
const popular = tracks.topics.filter((g) => g.seam === 'hooks' || g.seam === 'options');
---
<Page title="SpeedySpec Guide" template="splash" search={false}>
  <div class="home">
    <p class="home-tagline">Learn to write WordPress plugins: how WordPress's functions work together, how SpeedySpec runs them, and every function's reference. Every code example is run and checked on WordPress.</p>
    <button type="button" class="home-search" data-open-search>Search guides, functions, hooks</button>
    <HomeCards firstGuide={first ? guidePath(first) : '/guides/'} />
    {popular.length > 0 && (
      <p class="home-popular">Popular: {popular.map((g, i) => <>{i > 0 && ' · '}<a href={guidePath(g)}>{g.title}</a></>)}</p>
    )}
  </div>
  <script>
    // The big search button opens Starlight's search dialog, the same one as the header's.
    document.querySelector('[data-open-search]')?.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
    });
  </script>
</Page>
