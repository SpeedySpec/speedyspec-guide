---
import Base from '../../layouts/Base.astro';
import { loadGuideData } from '../../model/data.ts';
import { guidePath, guideTracks } from '../../model/guides.ts';

const t = guideTracks(await loadGuideData());
const list = (cls: string, guides: typeof t.path) => ({ cls, guides });
const contributing = [
  { name: 'WordPress core', ...list('guide-contributing-wordpress', t.contributing.wordpress) },
  { name: 'SpeedySpec', ...list('guide-contributing-speedyspec', t.contributing.speedyspec) },
];
---
<Base title="Guides" section="guides">
  <main class="page guides">
    <h1>Guides</h1>
    <p>Learn to write WordPress plugins, how WordPress's functions work together, and how SpeedySpec runs them. Every code example is run and checked on WordPress.</p>
    <h2>Learning path</h2>
    {t.path.length > 0 ? (
      <ol class="guide-path">
        {t.path.map((g) => <li><a href={guidePath(g)}>{g.title}</a> <span class="muted">{g.summary}</span></li>)}
      </ol>
    ) : <p class="guide-empty">No learning path guides yet.</p>}
    <h2>Topics</h2>
    {t.topics.length > 0 ? (
      <ul class="guide-topics">
        {t.topics.map((g) => <li><a href={guidePath(g)}>{g.title}</a> <span class="muted">{g.summary}</span></li>)}
      </ul>
    ) : <p class="guide-empty">No topic guides yet. Each seam's reference explains its functions meanwhile.</p>}
    <h2 id="contributing">Contributing</h2>
    {contributing.map((c) => (
      <section>
        <h3>{c.name}</h3>
        {c.guides.length > 0 ? (
          <ol class={c.cls}>
            {c.guides.map((g) => <li><a href={guidePath(g)}>{g.title}</a> <span class="muted">{g.summary}</span></li>)}
          </ol>
        ) : <p class="guide-empty">No guides for contributing to {c.name} yet.</p>}
      </section>
    ))}
  </main>
</Base>
