---
import MaybeLink from '../../../components/MaybeLink.astro';
import Diagram from '../../../components/Diagram.astro';
import Prose from '../../../components/Prose.astro';
import VerdictPill from '../../../components/VerdictPill.astro';
import Reference from '../../../layouts/Reference.astro';
import { loadGuideData } from '../../../model/data.ts';
import { guidePath, guideTracks } from '../../../model/guides.ts';
import { seamDiagram } from '../../../model/mermaid.ts';
import { seamRailView, seamView, wordpressSeams } from '../../../model/views.ts';
import { roleLabel } from '../../../model/wording.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return wordpressSeams(d).map((s) => ({ params: { seam: s.id } }));
}

const d = await loadGuideData();
const view = seamView(Astro.params.seam!, 'wordpress', d);
const intro = d.content.find((c) => c.section === 'wordpress' && c.seam === view.id && c.kind === 'seam');
const memberCount = view.roles.reduce((n, r) => n + r.members.length, 0);
const diagram = memberCount === 0 ? null : seamDiagram(view, d);
const elsewhere = d.seams.find((s) => s.id === view.id)?.elsewhere ?? [];
const written = new Set(d.content.filter((c) => c.section === 'wordpress' && c.kind === 'symbol').map((c) => c.symbol));
const topicGuide = guideTracks(d).topics.find((g) => g.seam === view.id);
---
<Reference title={view.name} description={view.job} rail={seamRailView(view.id, 'wordpress', d)} section="wordpress">
    <div class="crumbs"><a href="/wordpress/">WordPress API</a> › seam</div>
    {topicGuide && <p class="seam-guide">Guide: <a href={guidePath(topicGuide)}>{topicGuide.title}</a></p>}
    <p class="muted">{view.job}</p>
    {intro && <Prose entry={intro} />}
    {elsewhere.length > 0 && (
      <aside class="elsewhere">
        <h2>Documented elsewhere</h2>
        <p class="muted">These APIs ship with WordPress but belong to another project, so this guide leaves their functions and classes out; their own documentation describes them.</p>
        <ul>
          {elsewhere.map((e) => (
            <li><a href={e.docs}>{e.name}</a>{e.note && <span>: {e.note}</span>}</li>
          ))}
        </ul>
      </aside>
    )}
    {diagram ? <Diagram code={diagram} label={`The ${view.name} seam: its functions, classes and globals, and the seams it depends on`} /> : <p class="muted no-diagram">{memberCount === 0 ? 'This seam has no members yet.' : 'This seam is too large to draw; its members and their links are listed below.'}</p>}
    <div class="members">
      {view.roles.map((r) => (
        <section>
          <h2 id={`role-${r.role}`}>{roleLabel(r.role)}</h2>
          <ul>
            {r.members.map((m) => (
              <li class:list={['member', { circular: m.circular }]}>
                <MaybeLink class="mono" href={m.href}>{m.name}</MaybeLink> <VerdictPill verdict={m.verdict} />
                {m.circular && <span class="chip-note"> circular</span>}
                {!written.has(m.id) && <span class="muted"> · not yet documented</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
</Reference>
