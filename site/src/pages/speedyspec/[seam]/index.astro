---
import CompatTable from '../../../components/CompatTable.astro';
import DependencyList from '../../../components/DependencyList.astro';
import SeamCycles from '../../../components/SeamCycles.astro';
import Prose from '../../../components/Prose.astro';
import Base from '../../../layouts/Base.astro';
import { loadGuideData } from '../../../model/data.ts';
import { guidePath, guideTracks } from '../../../model/guides.ts';
import { compatGroups, dependencies, seamCycles } from '../../../model/sections.ts';
import { roleLabel } from '../../../model/wording.ts';
import { seamView } from '../../../model/views.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return d.seams.map((s) => ({ params: { seam: s.id } }));
}

const d = await loadGuideData();
const view = seamView(Astro.params.seam!, 'speedyspec', d);
const intro = d.content.find((c) => c.section === 'speedyspec' && c.seam === view.id && c.kind === 'seam');
const groups = compatGroups(view.id, d);
const { dependsOn, dependedOnBy } = dependencies(view.id, d);
const cycles = seamCycles(view.id, d);
const topicGuide = guideTracks(d).topics.find((g) => g.seam === view.id);
---
<Base title={`${view.name} · SpeedySpec API`} section="speedyspec">
  <main class="page" data-pagefind-body>
    <div class="crumbs"><a href="/speedyspec/">SpeedySpec API</a> › seam</div>
    <h1>{view.name}</h1>
    {topicGuide && <p class="seam-guide">Guide: <a href={guidePath(topicGuide)}>{topicGuide.title}</a></p>}
    <p class="muted">{view.ported ? 'Native (Rust): SpeedySpec answers this seam in Rust.' : 'Not in SpeedySpec yet: SpeedySpec provides this seam once it is ported. Until then this page lists its WordPress symbols.'}</p>
    {intro && <Prose entry={intro} />}
    <p class="seam-links"><a href={`/speedyspec/porting/${view.id}/`}>Porting guide</a> · <a href={`/speedyspec/architecture/${view.id}/`}>Architecture</a></p>

    <h2>Compatibility</h2>
    {groups.map((g) => (
      <>
        <h3 id={`role-${g.role}`}>{roleLabel(g.role)}</h3>
        <CompatTable rows={g.rows} />
      </>
    ))}

    <DependencyList title="Depends on" kind="depends-on" groups={dependsOn} data={d} limit={5} allHref={`/speedyspec/${view.id}/depends-on/`} />
    <DependencyList title="Depended on by" kind="depended-on-by" groups={dependedOnBy} data={d} limit={5} allHref={`/speedyspec/${view.id}/depended-on-by/`} />

    <SeamCycles cycles={cycles} data={d} limit={10} allHref={`/speedyspec/${view.id}/cycles/`} />
  </main>
</Base>
