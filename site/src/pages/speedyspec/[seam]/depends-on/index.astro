---
// The seams this seam's "Depends on" list reaches, each with its count, linking a page of every row for that seam.
import Reference from '../../../../layouts/Reference.astro';
import { seamRailView } from '../../../../model/views.ts';
import { loadGuideData } from '../../../../model/data.ts';
import { dependencies, seamIdByName } from '../../../../model/sections.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return d.seams.map((s) => ({ params: { seam: s.id } }));
}

const d = await loadGuideData();
const seam = d.seams.find((s) => s.id === Astro.params.seam)!;
const groups = [...dependencies(seam.id, d).dependsOn];
---
<Reference title={`${seam.name}: Depends on`} rail={seamRailView(seam.id, 'speedyspec', d)} section="speedyspec">
    <div class="crumbs"><a href="/speedyspec/">SpeedySpec API</a> › <a href={`/speedyspec/${seam.id}/`}>{seam.name}</a> › Depends on</div>
    {groups.length === 0 && <p class="muted">Nothing.</p>}
    <ul class="other-seams">
      {groups.map(([name, rows]) => (
        <li><a href={`/speedyspec/${seam.id}/depends-on/${seamIdByName(name, d)}/`}>{name}</a> <span class="muted">{rows.length} {rows.length === 1 ? 'symbol' : 'symbols'}</span></li>
      ))}
    </ul>
</Reference>
