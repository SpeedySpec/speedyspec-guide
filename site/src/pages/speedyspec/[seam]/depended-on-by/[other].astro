---
// Every row of this seam's "Depended on by" list for one other seam.
import DependencyList from '../../../../components/DependencyList.astro';
import Reference from '../../../../layouts/Reference.astro';
import { seamRailView } from '../../../../model/views.ts';
import { loadGuideData } from '../../../../model/data.ts';
import { dependencies, seamIdByName } from '../../../../model/sections.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return d.seams.flatMap((s) => [...dependencies(s.id, d).dependedOnBy.keys()].map((name) => ({ params: { seam: s.id, other: seamIdByName(name, d) } })));
}

const d = await loadGuideData();
const seam = d.seams.find((s) => s.id === Astro.params.seam)!;
const other = d.seams.find((s) => s.id === Astro.params.other);
const name = other?.name ?? Astro.params.other!;
const groups = new Map([...dependencies(seam.id, d).dependedOnBy].filter(([n]) => n === name));
---
<Reference title={`${seam.name}: Depended on by ${name}`} rail={seamRailView(seam.id, 'speedyspec', d)} section="speedyspec">
    <div class="crumbs"><a href="/speedyspec/">SpeedySpec API</a> › <a href={`/speedyspec/${seam.id}/`}>{seam.name}</a> › <a href={`/speedyspec/${seam.id}/depended-on-by/`}>Depended on by</a> › {name}</div>
    <DependencyList title="Depended on by" kind="depended-on-by" groups={groups} data={d} />
</Reference>
