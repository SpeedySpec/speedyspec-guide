---
// Every row of the seam page's "Circular dependencies" list, which the seam page shortens.
import SeamCycles from '../../../components/SeamCycles.astro';
import Reference from '../../../layouts/Reference.astro';
import { seamRailView } from '../../../model/views.ts';
import { loadGuideData } from '../../../model/data.ts';
import { seamCycles } from '../../../model/sections.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return d.seams.map((s) => ({ params: { seam: s.id } }));
}

const d = await loadGuideData();
const seam = d.seams.find((s) => s.id === Astro.params.seam)!;
---
<Reference title={`${seam.name}: Circular dependencies`} rail={seamRailView(seam.id, 'speedyspec', d)} section="speedyspec">
    <div class="crumbs"><a href="/speedyspec/">SpeedySpec API</a> › <a href={`/speedyspec/${seam.id}/`}>{seam.name}</a> › Circular dependencies</div>
    <SeamCycles cycles={seamCycles(seam.id, d)} data={d} />
</Reference>
