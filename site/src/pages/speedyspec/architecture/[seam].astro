---
import Diagram from '../../../components/Diagram.astro';
import Prose from '../../../components/Prose.astro';
import Reference from '../../../layouts/Reference.astro';
import { seamRailView } from '../../../model/views.ts';
import { loadGuideData } from '../../../model/data.ts';
import { seamPage } from '../../../model/guide-page.ts';
import { architectureDiagram } from '../../../model/mermaid.ts';

export async function getStaticPaths() {
  const d = await loadGuideData();
  return d.seams.map((s) => ({ params: { seam: s.id } }));
}

const d = await loadGuideData();
const seam = d.seams.find((s) => s.id === Astro.params.seam)!;
const page = seamPage(seam.id, 'architecture', d);
const hasParts = (seam.crates?.length ?? 0) > 0;
---
<Reference title={`Architecture: ${seam.name}`} rail={seamRailView(seam.id, 'speedyspec', d)} section="speedyspec">
    <div class="crumbs"><a href={`/speedyspec/${seam.id}/`}>{seam.name}</a> › architecture</div>
    {hasParts ? <Diagram code={architectureDiagram(seam, d.crates)} label={`The SpeedySpec crates of the ${seam.name} seam`} /> : <p class="muted">The seam names no crates yet.</p>}
    {page ? <Prose entry={page} /> : <p class="not-written">Not written yet.</p>}
</Reference>
