---
import Page from '../../layouts/Page.astro';
import { REFERENCE_SIDEBAR } from '../../model/starlight.ts';
import { loadGuideData } from '../../model/data.ts';
import { unplacedRuntime } from '../../model/sections.ts';
import { speedyspecProvenance } from '../../model/verdict.ts';

const d = await loadGuideData();
const unplaced = unplacedRuntime(d);
const kinds = [...new Set(unplaced.map((s) => s.kind))].sort();
---
<Page title={"The runtime's PHP API, not yet in a seam"} sidebar={REFERENCE_SIDEBAR}>
    <div class="crumbs"><a href="/speedyspec/">SpeedySpec API</a></div>
    <p class="muted">What the SpeedySpec runtime registers in PHP that WordPress doesn't have, and that no seam lists yet.</p>
    {unplaced.length === 0 && <p class="muted">Everything the runtime registers is in a seam.</p>}
    {kinds.map((k) => (
      <section>
        <h2>{k}</h2>
        <ul>
          {unplaced.filter((s) => s.kind === k).map((s) => (
            <li class="runtime-symbol"><span class="mono">{s.name}</span> <span class="muted">{s.signature ?? ''} · Added in SpeedySpec {speedyspecProvenance(s.id, d).added}</span></li>
          ))}
        </ul>
      </section>
    ))}
</Page>
