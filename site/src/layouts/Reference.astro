---
import SeamRail from '../components/SeamRail.astro';
import type { RailView, Section } from '../model/views.ts';
import Base from './Base.astro';

interface Props {
  title: string;
  rail: RailView;
  section: Section;
  current?: string;
}
const { title, rail, section, current } = Astro.props;
---
<Base title={title} section={section}>
  <div class="reference">
    <SeamRail rail={rail} section={section} current={current} />
    <main class="content" data-pagefind-body>
      <slot />
    </main>
  </div>
</Base>
