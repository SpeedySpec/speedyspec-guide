---
import { renderMermaid } from '../model/render-mermaid.ts';

interface Props {
  code: string;
  label: string;
}
const { code, label } = Astro.props;
const svg = await renderMermaid(code);
const data = (s: string) => `data:image/svg+xml;base64,${Buffer.from(s).toString('base64')}`;
---
<figure class="diagram">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={data(svg.dark)} />
    <img src={data(svg.light)} alt={label} />
  </picture>
</figure>
