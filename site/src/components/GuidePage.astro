---
// A guide's page: its summary and prose inside the guide shell, with every guide in the sidebar, the learning-path
// chapter, previous/next guides, and a marker at the end that counts the guide as read once it's seen.
import { getEntry, render } from 'astro:content';
import type { Guide } from '@speedyspec-guide/domain';
import GuideProse from './GuideProse.astro';
import Page from '../layouts/Page.astro';
import { loadGuideData } from '../model/data.ts';
import { guideTracks } from '../model/guides.ts';
import { chapterOf, guidePrevNext, guideSidebar } from '../model/starlight.ts';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const d = await loadGuideData();
const tracks = guideTracks(d);
const { prev, next } = guidePrevNext(guide, d);
const entry = await getEntry('guides', guide.file.replace(/\.mdx$/, ''));
const headings = entry ? (await render(entry)).headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
---
<Page title={guide.title} description={guide.summary} sidebar={guideSidebar(tracks)} headings={headings} prev={prev} next={next} chapter={chapterOf(guide, tracks)}>
  <div class="guide">
    <p class="summary">{guide.summary}</p>
    <slot name="before" />
    <GuideProse guide={guide} />
    <slot />
    <div class="guide-end" aria-hidden="true"></div>
  </div>
</Page>
