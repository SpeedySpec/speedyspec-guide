---
// Starlight's site title, followed by the site's sections (Decorator). On narrow screens the sections move out of the
// header: into the mobile menu (MobileMenuFooter.astro), or on pages without a sidebar, which have no mobile menu, into
// a strip at the top of the page (layouts/Page.astro).
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { HEADER_LINKS } from '../../model/starlight.ts';

const here = Astro.url.pathname;
const current = (href: string) => here.startsWith(href) || (href === '/reference/' && /^\/(wordpress|speedyspec|coverage)\//.test(here));
---
<Default><slot /></Default>
<nav class="site-links" aria-label="Sections">
  {HEADER_LINKS.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
</nav>
