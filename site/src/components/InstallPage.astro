---
// One page of the installation guide: its MDX body with the guide's pages in the sidebar and the pages before and
// after it; on the first page, the contents too.
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { loadGuideData } from '../model/data.ts';
import { INSTALL_INDEX, installNeighbours, installPath } from '../model/install.ts';
import { installSidebar } from '../model/starlight.ts';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const d = await loadGuideData();
const page = d.install.find((p) => p.slug === slug) ?? null;
const entry = page ? await getEntry('install', slug) : undefined;
if (page && !entry) throw new Error(`no content entry for ${page.file}`);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const headings = (rendered?.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const { previous, next } = installNeighbours(d.install, slug);
const title = page?.title ?? 'Installing SpeedySpec';
const link = (p: typeof previous) => (p ? { link: installPath(p.slug), label: p.title } : false);
---
<Page title={title} description={page?.summary} sidebar={installSidebar(d.install)} headings={headings} prev={link(previous)} next={link(next)}>
  {Content ? <div class="prose"><Content /></div> : <p class="not-written">Not written yet.</p>}
  {slug === INSTALL_INDEX && d.install.length > 0 && (
    <nav class="install-contents" aria-label="Installation guide">
      <h2>In this guide</h2>
      <ol>
        {d.install.map((p) => <li><a href={installPath(p.slug)}>{p.title}</a>{p.summary && <span class="muted"> · {p.summary}</span>}</li>)}
      </ol>
    </nav>
  )}
</Page>
