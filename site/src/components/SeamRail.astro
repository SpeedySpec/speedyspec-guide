---
import MaybeLink from './MaybeLink.astro';
import type { SeamView } from '../model/views.ts';
import { roleLabel } from '../model/wording.ts';

interface Props {
  seam: SeamView;
  section: 'wordpress' | 'speedyspec';
  current?: string;
}
const { seam, section, current } = Astro.props;
// A class's methods show only on the class's own page.
const open = (classId: string) => current === classId || current?.startsWith(`method:${classId.slice('class:'.length)}::`);
// Hooks of both kinds can share a name, so the rail says which.
const label = (m: { kind: string; name: string }) => (m.kind === 'filter' || m.kind === 'action' ? `${m.kind} ${m.name}` : m.name);
---
<nav class="rail" aria-label={`${seam.name} seam`}>
  <a class="rail-seam" href={`/${section}/${seam.id}/`}><b>{seam.name}</b> · seam</a>
  {seam.roles.map((r) => (
    <>
      <div class="rail-role">{roleLabel(r.role)}</div>
      {r.members.map((m) => (
        <>
          <MaybeLink class={m.circular ? 'rail-member circular' : 'rail-member'} href={m.href} current={m.id === current}>
            {label(m)}{m.circular && <span class="cycle-mark" aria-hidden="true">↻</span>}{m.circular && <span class="visually-hidden"> (circular)</span>}
          </MaybeLink>
          {m.methods && m.methods.length > 0 && open(m.id) && (
            <div class="rail-methods">
              {m.methods.map((x) => <MaybeLink class="rail-member" href={x.href} current={x.id === current}>::{x.name}</MaybeLink>)}
            </div>
          )}
        </>
      ))}
    </>
  ))}
</nav>
